# Supabase — worker credentials only. This key bypasses RLS and must never be
# bundled into the PWA; the frontend uses the publishable key plus user auth.
SUPABASE_URL=https://utrybuzjkttrmdcrugio.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Scraper defaults (optional overrides)
SCRAPE_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO
# Preferred: project secret key (sb_secret_...). Takes precedence over
# SUPABASE_SERVICE_ROLE_KEY below, which is legacy and often holds a
# publishable key that cannot write.
SUPABASE_SECRET_KEY=

# Notifications — Web Push (optional). An empty VAPID_PRIVATE_KEY keeps every
# run silent and never opens a socket, which is the safe default.
#
# Generate a pair (prints the private key and the matching public key):
#   openssl ecparam -name prime256v1 -genkey -noout -out private.pem
#   openssl pkcs8 -topk8 -nocrypt -in private.pem -outform DER | base64 -w0
#   openssl ec -in private.pem -pubout -outform DER | tail -c 65 | base64 -w0
# The third command prints the URL-safe public point: replace + with -, / with _
# and drop the padding. That value goes to PUBLIC_VAPID_PUBLIC_KEY in the
# frontend .env, never the private key.
#
# The private key stays on this machine: it signs every push and must never
# reach the browser bundle or the database.
VAPID_PRIVATE_KEY=
# VAPID contact, required by push services. Use a real mailbox you control.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
