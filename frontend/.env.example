# Copy to .env and fill in the publishable key.
# Every value here is inlined into the static bundle at build time, so only
# publishable values may ever be placed here.
PUBLIC_SUPABASE_URL=https://utrybuzjkttrmdcrugio.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Web Push public key (URL-safe base64, uncompressed P-256 point).
# It identifies this app to the browser push service; it is safe to ship.
# Without it the dashboard shows "Falta la clave pública de avisos".
PUBLIC_VAPID_PUBLIC_KEY=
